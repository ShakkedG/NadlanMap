import json
from pathlib import Path
from pyproj import Transformer

ROOT = Path(__file__).resolve().parents[1]
SOURCE = ROOT / 'public' / 'settlements.geojson'
TARGET = ROOT / 'public' / 'settlements_wkt_2039.json'

transformer = Transformer.from_crs('EPSG:4326', 'EPSG:2039', always_xy=True)


def fmt(number: float) -> str:
    return f'{number:.2f}'.rstrip('0').rstrip('.')


def ring_to_text(ring):
    points = []
    for lon, lat, *rest in ring:
        x, y = transformer.transform(lon, lat)
        points.append((x, y))
    if points and (round(points[0][0], 4), round(points[0][1], 4)) != (round(points[-1][0], 4), round(points[-1][1], 4)):
        points.append(points[0])
    return '(' + ', '.join(f'{fmt(x)} {fmt(y)}' for x, y in points) + ')'


def polygon_to_wkt(polygon):
    return 'POLYGON(' + ', '.join(ring_to_text(ring) for ring in polygon) + ')'


def bbox_from_polygon(polygon):
    xs = []
    ys = []
    for ring in polygon:
        for lon, lat, *rest in ring:
            x, y = transformer.transform(lon, lat)
            xs.append(x)
            ys.append(y)
    return [round(min(xs), 2), round(min(ys), 2), round(max(xs), 2), round(max(ys), 2)] if xs else None


def main():
    geojson = json.loads(SOURCE.read_text(encoding='utf-8'))
    features = []

    for feature in geojson.get('features', []):
        props = feature.get('properties') or {}
        sid = str(props.get('sid', '')).strip()
        name = str(props.get('name', '')).strip()
        geometry = feature.get('geometry') or {}
        geom_type = geometry.get('type')
        coords = geometry.get('coordinates') or []

        if not sid or not coords:
            continue

        if geom_type == 'Polygon':
            features.append({
                'sid': sid,
                'name': name,
                'part': 1,
                'wkt': polygon_to_wkt(coords),
                'bbox': bbox_from_polygon(coords)
            })
        elif geom_type == 'MultiPolygon':
            for part_index, polygon in enumerate(coords, start=1):
                features.append({
                    'sid': sid,
                    'name': name,
                    'part': part_index,
                    'wkt': polygon_to_wkt(polygon),
                    'bbox': bbox_from_polygon(polygon)
                })

    payload = {
        'type': 'GovMapWktFeatureCollection',
        'source': 'public/settlements.geojson',
        'sourceCrs': 'EPSG:4326',
        'targetCrs': 'EPSG:2039',
        'joinField': 'sid',
        'featureCount': len(features),
        'features': features
    }
    TARGET.write_text(json.dumps(payload, ensure_ascii=False, separators=(',', ':')), encoding='utf-8')
    print(f'Wrote {TARGET} with {len(features)} WKT polygons')


if __name__ == '__main__':
    main()
